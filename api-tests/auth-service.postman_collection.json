    {
      "name": "06 - Register, Refresh (Redis) & Logout",
      "description": "Refresh token: UUID luu Redis TTL 7 ngay. Can REDIS_* trong .env",
      "item": [
        {
          "name": "POST /api/auth/register (unique user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Tao user CUSTOMER; username/email unique moi lan chay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{regUsername}}\",\n  \"password\": \"Pass123!\",\n  \"email\": \"{{regEmail}}\",\n  \"name\": \"Postman Register User\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set(\"regUsername\", \"postman_user_\" + ts);",
                  "pm.environment.set(\"regEmail\", \"postman_\" + ts + \"@test.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Has tokens\", () => {",
                  "  pm.expect(j.data.accessToken).to.be.a(\"string\");",
                  "  pm.expect(j.data.refreshToken).to.be.a(\"string\");",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"refreshToken\", j.data.refreshToken);",
                  "  pm.environment.set(\"accessToken\", j.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
