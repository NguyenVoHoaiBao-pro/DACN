      "name": "02 - Track interactions (public direct)",
      "description": "Direct :8088 - khong can JWT",
      "item": [
        {
          "name": "POST /api/interactions/track - VIEW",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{statisticsUrl}}/api/interactions/track",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"actionType\": \"VIEW\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Has interaction data\", () => pm.expect(j.data).to.be.an(\"object\"));",
                  "pm.test(\"VIEW score 1.0\", () => pm.expect(Number(j.data.interactionScore)).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/interactions/track - CLICK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{statisticsUrl}}/api/interactions/track",
            "description": "Alias CLICK -> luu CART score 3.0 theo DB",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"2\",\n  \"actionType\": \"CLICK\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Has interaction data\", () => pm.expect(j.data).to.be.an(\"object\"));",
                  "pm.test(\"CLICK normalized to CART (DB)\", () => pm.expect(j.data.actionType).to.eql(\"CART\"));",
                  "pm.test(\"CART score 3.0\", () => pm.expect(Number(j.data.interactionScore)).to.eql(3));"
                ]
              }
            }
          ]
        },
