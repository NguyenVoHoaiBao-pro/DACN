      "name": "00 - OpenAPI & Health",
      "description": "Can catalog-service :8082 + MySQL electro_catalog_db",
      "item": [
        {
          "name": "GET OpenAPI v3/api-docs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalogUrl}}/v3/api-docs",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"OpenAPI 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Paths documented\", () => {",
                  "  pm.expect(j.paths).to.have.property(\"/api/products\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/products/{id}\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/products/search\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/categories\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/categories/{id}\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/producers\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/admin/inventory/import\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/admin/suppliers\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/admin/purchase-orders\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/products/internal/{productId}\");",
                  "  pm.expect(j.paths).to.have.property(\"/api/internal/catalog/variants/{variantId}/cart-info\");",
                  "});"
                ]
              }
            }
          ]
        },
