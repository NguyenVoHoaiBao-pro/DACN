            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/login",
            "description": "Can auth :8081. Token CUSTOMER thuong 403 tren admin catalog",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set(\"accessToken\", j.data.accessToken);",
                  "pm.collectionVariables.set(\"accessToken\", j.data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
