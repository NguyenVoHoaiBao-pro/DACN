# Copy thành frontend/.env
#
# DEV (npm run dev): KHÔNG cần VITE_API_URL — Vite proxy /api → localhost:8080
#   • http://localhost:5173  ✅
#   • http://<IP-LAN>:5173   ✅ (test điện thoại / QR)
#
# PRODUCTION build: bắt buộc set gateway thật
# VITE_API_URL=https://api.yourshop.com

# AI gợi ý (statistics-service gọi nội bộ; frontend chỉ cần gateway)
# VITE_AI_SERVICE_URL=http://localhost:5003
