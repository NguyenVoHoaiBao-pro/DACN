# Copy file nay thanh .env (gitignore — khong commit mat khau)
# Local Docker MySQL (mac dinh khi khong co .env):
#   MYSQL_HOST=localhost  MYSQL_PORT=3306  MYSQL_USER=root  MYSQL_PASSWORD=

# --- Aiven MySQL (cung host/user/pass, moi service dung DB rieng trong application.yml) ---
MYSQL_HOST=mysql-11ae5c82-cjcakvalvajvjallh.i.aivencloud.com
MYSQL_PORT=28570
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_password_here

# SSL (bat buoc voi Aiven)
MYSQL_USE_SSL=true
MYSQL_REQUIRE_SSL=true
MYSQL_SSL_MODE=REQUIRED

# Tren Aiven da tao DB san — khong tu tao khi start app
MYSQL_CREATE_DB=false

# Ten DB tung service (da import tu database/schemas/):
#   catalog-service    -> electro_catalog_db
#   user-service       -> electro_user_db
#   cart-service       -> electro_cart_db
#   order-service      -> electro_order_db
#   review-service     -> electro_review_db
#   statistics-service -> electro_statistics_db

# --- Redis Cloud (cloud.redis.io) — auth refresh token + statistics queue ---
# Cach 1: URL day du (uu tien — auth/statistics tu dong dung khi co REDIS_URL)
# redis:// = khong TLS (port 14085 cloud.redis.io thuong dung cach nay)
# rediss:// = co TLS
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST.db.redis.io:14085
#
# Cach 2: Tach bien (tu dashboard Redis Cloud)
REDIS_HOST=YOUR_HOST.cloud.redislabs.com
REDIS_PORT=16379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL=false
# Neu dung REDIS_URL thi scheme redis:// = false, rediss:// = true

# JWT (cung secret cho auth-service, gateway, user/cart/order)
JWT_SECRET=your_jwt_signing_secret_min_32_chars

# Tai khoan test API (user khang_test trong DB seed — doi neu ban doi mat khau)
TEST_USERNAME=khang_test
TEST_PASSWORD=your_test_password_here

# Google Sign-In (optional) — Client ID tu Google Cloud Console
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

