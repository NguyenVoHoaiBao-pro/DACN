# Sao chep thanh reco-service/.env hoac them vao .env goc du an

AI_PORT=5003
APP_NAME=reco-service
EUREKA_SERVER_URL=http://localhost:8761/eureka/
INSTANCE_HOST=localhost

# Fallback URLs khi Eureka chua san sang
REVIEW_SERVICE_URL=http://localhost:8087
ORDER_SERVICE_URL=http://localhost:8086

# Training data
RECO_FAKE_PURCHASE_RATING=3.5
RECO_MAX_LATEST_RATINGS=50

# Synthetic augment (lam day du lieu train khi DB mong)
RECO_SYNTHETIC_AUGMENT=true
RECO_SYNTHETIC_TARGET_INTERACTIONS=1500
RECO_SYNTHETIC_MIN_PER_USER=8
RECO_MIN_TRAIN_INTERACTIONS=100

# SVD hyperparameters (Surprise)
SVD_N_FACTORS=50
SVD_N_EPOCHS=20
SVD_LR_ALL=0.005
SVD_REG_ALL=0.02
SVD_TEST_SIZE=0.2
